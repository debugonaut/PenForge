# PenForge private-beta environment for the API + worker container.
#
# Copy to .env.beta (git-ignored), fill in the real values, and never commit it.
# Generate the two secrets with: openssl rand -hex 32

APP_ENV=production
PORT=8080

# --- Database -----------------------------------------------------------------
# Managed PostgreSQL reachable from the container. Keep sslmode=require for a
# provider that terminates TLS. The compose file overrides this value locally.
DATABASE_URL=postgresql+psycopg://USER:CHANGE_ME@HOST:5432/DBNAME?sslmode=require
DATABASE_POOL_SIZE=5

# --- Identity (Firebase Spark plan, email/password) ---------------------------
AUTH_BACKEND=firebase
FIREBASE_PROJECT_ID=penforge-handwriting
CLAIM_MAX_AGE_SECONDS=600

# --- Shared admission limits (required with hosted identity) ------------------
RATE_LIMIT_BACKEND=postgres
IDENTITY_RATE_LIMIT=60
IDENTITY_FIRST_REQUEST_LIMIT=10
IDENTITY_GLOBAL_FIRST_REQUEST_LIMIT=100
CLAIM_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Private object storage (S3-compatible) -----------------------------------
STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_S3_BUCKET=penforge-private
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=REPLACE
STORAGE_S3_SECRET_KEY=REPLACE
STORAGE_S3_PREFIX=beta/
# R2 and Supabase Storage need path-style addressing; AWS S3 does not.
STORAGE_S3_PATH_STYLE=true

# --- Signing and privacy ------------------------------------------------------
HMAC_SECRET=REPLACE_WITH_32_BYTE_HEX
PRIVACY_HMAC_SECRET=REPLACE_WITH_32_BYTE_HEX
HMAC_KEY_VERSION=v1

# --- Browser origin -----------------------------------------------------------
# JSON array; exactly the deployed frontend origin, no paths.
CORS_ALLOWED_ORIGINS=["https://penforge-beta.vercel.app"]

# --- Service accountability (required for a non-local environment) ------------
SERVICE_OPERATOR_NAME=PenForge beta operator
SERVICE_OPERATOR_CONTACT=owner@example.com
SERVICE_TERMS_REVIEWED=true

# --- Worker -------------------------------------------------------------------
WORKER_MODE=scheduled
WORKER_MAX_RUN_SECONDS=300
WORKER_TEMP_ROOT=/tmp/penforge-worker-temp
# Supervisor cadence: full passes while traffic is recent, a slow safety poll when idle.
WORKER_IDLE_PASS_SECONDS=30
WORKER_IDLE_POLL_SECONDS=600
WORKER_WAKE_GRACE_SECONDS=30
WORKER_WAKE_FILE=/tmp/penforge-worker-wake

# --- Explicit operator steps (set only when running them) ---------------------
# BETA_MIGRATE=upgrade
