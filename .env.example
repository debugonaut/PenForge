# Local credentials only. Provider/secrets decisions remain gated in Phase 11.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://penforge:penforge@127.0.0.1:5433/penforge
AUTH_BACKEND=disabled
LOCAL_AUTH_TOKEN=local-penforge-development-only
STORAGE_BACKEND=local_fs
STORAGE_ROOT=.local/objects
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Set a unique >=32-character secret before starting the separate loopback readiness app.
# READINESS_TOKEN=

# Optional identity emulator settings are in .env.identity.example (local only).
# Before rotating HMAC_SECRET, pin its existing value as PRIVACY_HMAC_SECRET in
# the secret store. Keep the privacy key stable for journal/receipt verification.
# PRIVACY_HMAC_SECRET=
# Auth stays disabled until explicitly configured. No local draft service switch occurs.

# Shared local three-handler worker. These are runtime bounds, not provider capacity.
WORKER_MODE=scheduled
WORKER_MAX_RUN_SECONDS=300
# Persistent mode uses the same queue/lease/checkpoint protocol.
# Queue caps, degradation and quota tiers live in versioned system_settings records.

# Hosted-service legal gate (unset until actual operator details and Indian legal review).
# These are not a software licence or a substitute for the existing hosted gates.
# SERVICE_OPERATOR_NAME=
# SERVICE_OPERATOR_CONTACT=
SERVICE_TERMS_REVIEWED=false
