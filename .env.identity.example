# Explicit LOCAL emulator configuration; never load this in production.
# API reads environment only; export values in your API shell.
APP_ENV=local
AUTH_BACKEND=firebase
STORAGE_BACKEND=disabled
FIREBASE_PROJECT_ID=demo-penforge-identity
FIREBASE_ALLOW_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CLAIM_MAX_AGE_SECONDS=600
RATE_LIMIT_BACKEND=local
IDENTITY_RATE_LIMIT=60
IDENTITY_FIRST_REQUEST_LIMIT=10
IDENTITY_GLOBAL_FIRST_REQUEST_LIMIT=100
CLAIM_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
# HMAC_SECRET must be a unique >=32-character secret. Omitted locally => ephemeral random key.
HMAC_KEY_VERSION=v1
# Next.js public client settings: separate frontend shell/build only.
NEXT_PUBLIC_PENFORGE_AUTH_BACKEND=firebase
NEXT_PUBLIC_PENFORGE_ENV=local
NEXT_PUBLIC_PENFORGE_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-penforge-identity
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
