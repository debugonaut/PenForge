{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$",
          "title": "Record Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "confidence_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Interval"
        },
        "n": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "unit": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "unit"
      ],
      "title": "Metric",
      "type": "object"
    }
  },
  "$id": "https://penforge.invalid/research/v1/benchmark_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bytes_in": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bytes In"
    },
    "bytes_out": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bytes Out"
    },
    "code_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Ref"
    },
    "condition": {
      "default": "clean",
      "enum": [
        "clean",
        "adverse"
      ],
      "title": "Condition",
      "type": "string"
    },
    "config_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Hash"
    },
    "cpu": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cpu"
    },
    "created_on": {
      "format": "date",
      "title": "Created On",
      "type": "string"
    },
    "dataset_manifests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Dataset Manifests",
      "type": "array"
    },
    "dimension": {
      "enum": [
        "recognition",
        "alignment_segmentation",
        "outline_quality",
        "writer_fidelity",
        "cursive_behavior",
        "script_shaping",
        "font_export",
        "user_burden",
        "operations"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "evidence_domain": {
      "default": "real_heldout",
      "enum": [
        "real_heldout",
        "synthetic_control"
      ],
      "title": "Evidence Domain",
      "type": "string"
    },
    "input_class": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$",
      "title": "Input Class",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "measured_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured On"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "model_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "n": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N"
    },
    "p50_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P50 Ms"
    },
    "p95_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P95 Ms"
    },
    "peak_rss_mb": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Peak Rss Mb"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "ram_mb": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ram Mb"
    },
    "record_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "const": "benchmark_record",
      "default": "benchmark_record",
      "title": "Record Type",
      "type": "string"
    },
    "runtime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "script_code": {
      "enum": [
        "Latn",
        "Deva"
      ],
      "title": "Script Code",
      "type": "string"
    },
    "split": {
      "enum": [
        "validation",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "split_registry_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split Registry Hash"
    },
    "stage": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,119}$",
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "enum": [
        "unmeasured",
        "measured"
      ],
      "title": "Status",
      "type": "string"
    },
    "style": {
      "enum": [
        "print",
        "cursive",
        "mixed"
      ],
      "title": "Style",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    }
  },
  "required": [
    "record_id",
    "created_on",
    "status",
    "dimension",
    "script_code",
    "style",
    "stage",
    "input_class",
    "split",
    "limitations"
  ],
  "title": "BenchmarkRecord",
  "type": "object"
}
